{
  "manifest_version": 2,
  "name": "SortBro – smart mejlsortering",
  "version": "1.0.0",
  "description": "Smart mejlsortering för Thunderbird: styr olästa och lästa mejl per regel eller sortera i lugn och ro efter läsning.",
  "applications": {
    "gecko": {
      "id": "lasfilter@lokala-verktyg.invalid",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "storage",
    "downloads"
  ],
  "background": {
    "scripts": [
      "core.js",
      "engine.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Öppna SortBro",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "64": "icon-64.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "64": "icon-64.png",
    "128": "icon-128.png"
  },
  "options_ui": {
    "page": "ui.html",
    "open_in_tab": true
  },
  "content_security_policy": "script-src 'self'; object-src 'self'; connect-src 'none'",
  "commands": {
    "sweep": {
      "description": "Kör flyttsvep nu",
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      }
    },
    "open_ui": {
      "description": "Öppna SortBro",
      "suggested_key": {
        "default": "Alt+Shift+L"
      }
    }
  }
}
